{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "simply-blocks/container",
	"title": "Simply Container",
	"category": "simply-blocks",
	"description": "Full-width section with constrained inner content and section color schemes.",
	"keywords": [ "simply", "container", "section", "layout" ],
	"textdomain": "simply-blocks",
	"supports": {
		"html": false,
		"color": false,
		"spacing": false
	},
	"attributes": {
		"sectionColor": {
			"type": "string",
			"default": ""
		},
		"innerWidth": {
			"type": "number",
			"default": 1200
		},
		"paddingTop": {
			"type": "number",
			"default": 80
		},
		"paddingBottom": {
			"type": "number",
			"default": 80
		},
		"paddingLeft": {
			"type": "number",
			"default": 5
		},
		"paddingRight": {
			"type": "number",
			"default": 5
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
