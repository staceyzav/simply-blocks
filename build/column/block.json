{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "simply-blocks/column",
  "title": "Simply Column",
  "category": "simply-blocks",
  "description": "An individual column inside a Simply Columns block.",
  "parent": [
    "simply-blocks/columns"
  ],
  "textdomain": "simply-blocks",
  "attributes": {
    "verticalAlign": {
      "type": "string",
      "default": ""
    },
    "horizontalAlign": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "inserter": false,
    "layout": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}